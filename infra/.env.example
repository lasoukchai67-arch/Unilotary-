# ໂດເມນຂອງເຊີບເວີ (ຕ້ອງຊີ້ DNS ມາຫາເຊີບເວີກ່ອນ) ແລະ ອີເມວສຳລັບໃບຮັບຮອງ HTTPS
DOMAIN=api.example.la
ACME_EMAIL=it@example.la

# ສ້າງຄ່າສຸ່ມ: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ໃຊ້ development ສະເພາະເຊີບເວີທົດລອງ (ເປີດໃຊ້ OTP ແລະ ການຈ່າຍເງິນແບບທົດລອງໄດ້)
NODE_ENV=production

# SMS gateway (http) — ເອົາຂໍ້ມູນຈາກຜູ້ໃຫ້ບໍລິການ
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=LOTTERY

# ການຈ່າຍເງິນ — ເອົາຂໍ້ມູນຈາກທະນາຄານ / LAPNet
PAYMENT_PROVIDER=lapnet
LAPNET_API_URL=
LAPNET_MERCHANT_ID=
LAPNET_API_KEY=
