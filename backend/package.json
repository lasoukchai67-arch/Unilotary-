    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
