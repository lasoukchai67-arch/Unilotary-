# ---- ພື້ນຖານ ----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://lottery:lottery@localhost:5432/lottery
REDIS_URL=redis://localhost:6379
# ໃຊ້ສະຕຣິງສຸ່ມຍາວຢ່າງໜ້ອຍ 32 ໂຕ (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
TIMEZONE=Asia/Vientiane

# ---- ຜູ້ໃຫ້ບໍລິການ SMS: mock | http ----
SMS_PROVIDER=mock
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=LOTTERY

# ---- ຜູ້ໃຫ້ບໍລິການຈ່າຍເງິນ: mock | lapnet ----
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
LAPNET_API_URL=
LAPNET_MERCHANT_ID=
LAPNET_API_KEY=
