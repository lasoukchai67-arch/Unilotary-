# 1. Database Configuration (Required for Production)
# Must use PostgreSQL to support Audit Triggers (RULE 4)
DATABASE_URL=postgresql://user:password@localhost:5432/sokxay_db

# 2. Security (Change this in production!)
SECRET_KEY=SOKXAY_ENTERPRISE_SECRET_KEY_99283741829374

# 3. Cloud Storage (Cloudflare R2 or AWS S3)
# To use Cloudflare R2, provide the Account ID and Keys
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
S3_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
AWS_REGION=auto
